{
  "name": "firebase_proxy",
  "version": "0.1.5",
  "private": true,
  "description": "Reverse proxy for Firebase endpoints (Auth, Remote Config, Analytics) for regions where googleapis.com is blocked",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "typecheck": "bunx tsc --noEmit",
    "test:unit": "bun test"
  },
  "devDependencies": {
    "@types/bun": "~1.3.14",
    "typescript": "~5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/firebase_proxy.git"
  }
}
